{
  "name": "@chatsplice/desktop",
  "productName": "ChatSplice",
  "description": "A macOS coding workspace connecting ChatGPT to local projects through MCP.",
  "author": {
    "name": "ChatSplice contributors",
    "url": "https://github.com/dev-restart/ChatSplice"
  },
  "homepage": "https://github.com/dev-restart/ChatSplice",
  "version": "0.0.1",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "pnpm build:main && pnpm build:preload && pnpm build:renderer",
    "build:main": "tsc -p tsconfig.main.build.json",
    "build:preload": "esbuild src/preload/index.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/preload/index.cjs",
    "build:renderer": "vite build",
    "dev": "pnpm build && node ../../scripts/run-branded-electron.mjs",
    "start": "node ../../scripts/run-branded-electron.mjs",
    "test:unit": "vitest run --config vitest.config.ts",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && svelte-check --tsconfig ./tsconfig.renderer.json",
    "pack:mac": "node scripts/package-daemon.mjs && electron-builder --mac dmg --arm64 --publish never",
    "pack:mac:signed": "node scripts/package-daemon.mjs && electron-builder --config electron-builder.signed.cjs --mac --arm64 --publish never"
  },
  "dependencies": {
    "@chatsplice/protocol": "workspace:*",
    "@codemirror/commands": "6.11.0",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-rust": "6.0.2",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.12.4",
    "@codemirror/legacy-modes": "6.5.4",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.4",
    "@codemirror/view": "6.43.11",
    "@lezer/highlight": "1.2.3",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "electron-updater": "6.8.9",
    "node-pty": "1.1.0",
    "svelte": "5.56.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@chatsplice/mcp-server": "workspace:*",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@tailwindcss/vite": "4.3.3",
    "electron": "43.5.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "svelte-check": "4.7.5",
    "tailwindcss": "4.3.3",
    "vite": "8.2.1",
    "vitest": "4.1.11"
  }
}
