{
  "name": "@chatsplice/mcp-server",
  "version": "0.0.1",
  "license": "MIT",
  "private": true,
  "type": "module",
  "bin": {
    "chatspliced": "./bin/chatspliced.mjs",
    "localchatd": "./bin/chatspliced.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/bin/chatspliced.ts",
    "start": "node dist/bin/chatspliced.js",
    "test:unit": "vitest run src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@chatsplice/core": "workspace:*",
    "@chatsplice/protocol": "workspace:*",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "tsx": "4.23.12",
    "vitest": "4.1.11"
  }
}
